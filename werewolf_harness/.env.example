# copy to .env; models other than "mock" need the LLM_* keys
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TOOL_MODE=native

# online service (app/)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wh
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
NODE_ID=node-1
# local | streams  (streams = LLM turns go through Redis Streams to separate worker processes)
AGENT_EXECUTOR=local
DAILY_BUDGET_USD=5

# docker compose (make up / make smoke). In containers DATABASE_URL, REDIS_URL, NODE_ID and
# AGENT_EXECUTOR above are overridden by deploy/docker-compose.yml; these only steer compose itself.
# DOMAIN=werewolf.example.com      # unset = plain HTTP on any host name; a real domain = automatic HTTPS
# HTTP_PORT=8080                   # Caddy on the host (80 / 443 on a VPS)
# HTTPS_PORT=8443
# API_PORT=8402                    # api1 directly, bound to 127.0.0.1
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# WORKERS=2                        # model worker replicas (make up WORKERS=4 also works)
# POSTGRES_PASSWORD=postgres
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318   # with: docker compose --profile tracing up

# local Claude Code CLI as a model (HOST ONLY: not available inside the containers): seats named claude-cli, claude-cli:sonnet / :haiku / :opus
# need no key here -- they use whatever `claude` is signed in with (subscription or API key).
# CLAUDE_CLI_BIN=claude            # path to the executable, if not on PATH
# CLAUDE_CLI_CONCURRENCY=4         # max CLI processes at once (each is a Node process, ~250 MB)
# CLAUDE_CLI_BARE=0                # 1 = --bare (no hooks/plugins/CLAUDE.md); bare authenticates ONLY with ANTHROPIC_API_KEY
# CLAUDE_CLI_EXTRA_ARGS=           # appended verbatim, e.g. --effort low
